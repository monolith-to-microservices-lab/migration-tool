# ---------------------------------------------------------------------------
# migration-tool configuration
# Copy to `.env` and adjust. No secrets are committed to the repository.
# ---------------------------------------------------------------------------

# Legacy monolith PostgreSQL. The migration-tool reads BUSINESS DATA from here
# and NOWHERE else at the database level. The connection is opened READ ONLY.
# (psycopg 3 driver, matching the other services.)
LEGACY_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/monolith

# New microservices - reached over HTTP ONLY. The tool never connects to their
# databases (User PostgreSQL :5433 / Sales PostgreSQL :5434) directly.
USER_SERVICE_URL=http://localhost:8001
SALES_SERVICE_URL=http://localhost:8080

# How many legacy rows to pull / push per batch.
BATCH_SIZE=100

# HTTP client tuning.
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.2

# Operational metadata store for the migration-tool itself. This is NOT a copy
# of the business data - only run bookkeeping and per-item rollback snapshots.
MIGRATION_STATE_DATABASE_URL=sqlite:///migration_state.db

# Rollback is destructive (it DELETEs rows from the new services via their APIs).
# It is refused unless this is true AND `--confirm` is passed on the command line.
ALLOW_DESTRUCTIVE_ROLLBACK=false

# Where human-readable + JSON run reports are written.
REPORT_DIR=./reports

# Logging: json | console
LOG_FORMAT=json
LOG_LEVEL=INFO
